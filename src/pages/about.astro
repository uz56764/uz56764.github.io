---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import ResearchList from '../components/ResearchList.astro';
import Timeline from '../components/Timeline.astro';
import { profile } from '../data/profile';
import { getPosts, postUrl } from '../lib/posts';
import { displayTitle, formatDate, formatMoney, site, url } from '../lib/site';

const recent = (await getPosts()).slice(0, 4);

const medals: Record<string, string> = { '1st': 'gold', '2nd': 'silver', '3rd': 'bronze' };

// Drop a photo at src/assets/profile.{jpg,png,webp} and it appears here.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/profile.{jpg,jpeg,png,webp,avif}', { eager: true });
const photo = Object.values(photos)[0]?.default;
---

<Base title="About Me" description={`${site.fullName} — ${site.role}. ${profile.summary}`} current="about">
  <section class="shell about-hero" aria-labelledby="about-name">
    <div>
      <p class="eyebrow no-print">About Me</p>
      <h1 class="about-name" id="about-name">{site.fullName}</h1>
      <p class="about-role">{site.role} <span>@{site.author}</span></p>
      {/* The CV has no Contact section, so the address goes under the name. */}
      <p class="about-contact">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {site.links.map(link => <a href={link.href}>{link.label}</a>)}
      </p>
      <p class="lede about-summary">{profile.summary}</p>
      <div class="about-actions no-print">
        <a class="button button-primary" href={url(profile.cv)} download>
          <Icon name="download" size={16} />
          Download CV
        </a>
        <a class="text-link" href="#contact">
          Contact
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
    <figure class="portrait">
      {photo ? (
        <Image src={photo} alt={site.fullName} widths={[320, 640]} sizes="(max-width: 900px) 160px, 300px" loading="eager" />
      ) : (
        <span class="portrait-placeholder" aria-hidden="true"><Mark size={48} /></span>
      )}
    </figure>
  </section>

  <div class="divider"></div>

  <div class="shell">
    <section class="about-section" aria-labelledby="introduction">
      <h2 class="about-heading" id="introduction">Introduction</h2>
      <div class="about-prose">
        {profile.introduction.map(paragraph => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="about-section long" aria-labelledby="research">
      <h2 class="about-heading" id="research">Vulnerability Research</h2>
      <ResearchList targets={profile.research} />
    </section>

    <section class="about-section" aria-labelledby="experience">
      <h2 class="about-heading" id="experience">Experience</h2>
      <Timeline entries={profile.experience} />
    </section>

    <section class="about-section" aria-labelledby="projects">
      <h2 class="about-heading" id="projects">Projects</h2>
      <ul class="projects" role="list">
        {profile.projects.map(project => (
          <li class="project">
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-section" aria-labelledby="awards">
      <h2 class="about-heading" id="awards">Selected Awards</h2>
      <div class="awards">
        {profile.awards.map(group => (
          <div class="award-year">
            <h3 class="award-year-label">{group.year}</h3>
            <ul class="award-list" role="list">
              {group.entries.map(award => (
                <li class="award">
                  <span class:list={['award-place', medals[award.place]]}>{award.place}</span>
                  <span class="award-event">{award.event}</span>
                  {award.international && <span class="award-scope">International</span>}
                  {award.prize && <span class="award-prize">{formatMoney(award.prize.amount, award.prize.currency)}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="about-section" aria-labelledby="education">
      <h2 class="about-heading" id="education">Education</h2>
      <Timeline entries={profile.education} />
    </section>

    {recent.length > 0 && (
      <section class="about-section no-print" aria-labelledby="writing">
        <h2 class="about-heading" id="writing">Recent Articles</h2>
        <ul class="writing-list" role="list">
          {recent.map(post => (
            <li class="writing-entry">
              <span class="writing-text">
                <a class="writing-title stretched-link" href={postUrl(post)}>{displayTitle(post.data.title)}</a>
                <span class="writing-meta">{post.data.category} · {formatDate(post.data.date, 'short')}</span>
              </span>
              <Icon class="writing-arrow" name="arrow-right" size={18} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="about-section no-print" id="contact" aria-labelledby="contact-title">
      <h2 class="about-heading" id="contact-title">Contact</h2>
      <div class="contact">
        <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
        <div class="contact-actions">
          <button class="button" type="button" data-copy-email={site.email}>
            <Icon name="copy" size={15} />
            <span data-label>Copy address</span>
          </button>
          {site.links.map(link => (
            <a class="button" href={link.href} target="_blank" rel="me noopener">
              {link.label}
              <Icon name="arrow-up-right" size={14} />
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { bindCopyButton } from '../scripts/clipboard';

  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach(button => {
    bindCopyButton(button, () => button.dataset.copyEmail ?? '', { message: 'Email address copied to clipboard.' });
  });
</script>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: start;
    gap: 48px clamp(48px, 7vw, 112px);
    padding-block: clamp(56px, 8vw, 104px) clamp(48px, 6vw, 64px);
  }

  .about-name {
    margin-top: 20px;
    font-size: clamp(52px, 6.4vw, 84px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .about-role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin-top: 18px;
    font-size: 18px;
    color: var(--text-body);
  }

  .about-role span {
    font: 400 13px/1 var(--font-mono);
    color: var(--faint);
  }

  .about-contact {
    display: none;
  }

  .about-summary {
    max-width: 50ch;
    margin-top: 18px;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 32px;
  }

  .portrait {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--panel);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--line-strong);
  }

  /* Sections: a label column beside the content. */

  .about-section {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 20px 48px;
    padding-block: clamp(40px, 5vw, 56px);
  }

  .about-section + .about-section {
    border-top: 1px solid var(--line);
  }

  .about-heading {
    font-family: var(--font-pixel);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .about-prose {
    display: grid;
    gap: 1.1em;
    max-width: 68ch;
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-body);
  }

  .projects {
    display: grid;
    gap: 22px;
  }

  .project h3 {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
  }

  .project p {
    max-width: 68ch;
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
  }

  /* Awards: grouped by year, placing in a fixed column. */

  .awards {
    display: grid;
    gap: 24px;
  }

  .award-year {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 16px;
  }

  .award-year-label {
    padding-top: 2px;
    font: 400 13px/1.5 var(--font-mono);
    color: var(--faint);
  }

  .award-list {
    display: grid;
    gap: 8px;
  }

  /* Placing, event, scope, prize. The prize column has a fixed width so
     amounts line up with or without a scope. */
  .award {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto 104px;
    align-items: baseline;
    gap: 16px;
    font-size: 15px;
    line-height: 1.5;
  }

  .award-place {
    font: 400 13px/1.5 var(--font-mono);
    color: var(--text);
  }

  .award-place.gold {
    color: var(--gold);
  }

  .award-place.silver {
    color: var(--silver);
  }

  .award-place.bronze {
    color: var(--bronze);
  }

  .award-event {
    color: var(--text-body);
  }

  .award-scope {
    font: 400 12px/1.5 var(--font-mono);
    color: var(--faint);
  }

  .award-prize {
    grid-column: 4;
    justify-self: end;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--text-body);
  }

  .writing-entry {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18px;
    align-items: center;
    gap: 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }

  .writing-entry:first-child {
    padding-top: 0;
  }

  .writing-text {
    display: grid;
    gap: 6px;
  }

  .writing-title {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
    transition: color 0.15s;
  }

  .writing-meta {
    font: 400 12px/1.4 var(--font-mono);
    color: var(--faint);
  }

  .writing-entry :global(.writing-arrow) {
    color: var(--faint);
    transition: color 0.15s, transform 0.2s var(--ease);
  }

  .writing-entry:hover .writing-title,
  .writing-entry:hover :global(.writing-arrow) {
    color: var(--lime);
  }

  .writing-entry:hover :global(.writing-arrow) {
    transform: translateX(3px);
  }

  .contact {
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  .contact-email {
    font-size: clamp(22px, 2.8vw, 32px);
    font-weight: 500;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
    transition: color 0.15s;
  }

  .contact-email:hover {
    color: var(--lime);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 900px) {
    .about-hero,
    .about-section {
      grid-template-columns: 1fr;
    }

    .portrait {
      grid-row: 1;
      width: 160px;
    }
  }

  @media (max-width: 640px) {
    .award-year {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .award {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 0 16px;
    }

    .award-scope {
      display: none;
    }

    /* Under the event, so the name keeps the full width. */
    .award-prize {
      grid-column: 2;
      justify-self: start;
      font-size: 13px;
    }
  }

  /* Printable CV (public/jinu-kim-cv.pdf is rendered from this). A4 is
     narrower than the 900px breakpoint, so the layout is restated here.
     Page 1 holds the introduction and research; the rest starts page 2. */
  @page {
    size: A4;
    margin: 16mm 16mm 15mm;

    @bottom-right {
      content: counter(page) ' / ' counter(pages);
      font: 400 8px 'Geist Mono', monospace;
      color: #888;
    }
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .about-hero {
      grid-template-columns: minmax(0, 1fr) 104px;
      gap: 24px;
      padding-block: 0 18px;
    }

    .portrait {
      grid-row: auto;
      width: 104px;
    }

    .about-name {
      margin-top: 0;
      font-size: 34px;
    }

    .about-role {
      margin-top: 8px;
      font-size: 13px;
    }

    .about-contact {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 16px;
      margin-top: 6px;
      font: 400 10.5px/1.4 var(--font-mono);
      color: var(--text-body);
    }

    .about-summary {
      margin-top: 10px;
      font-size: 12.5px;
    }

    .about-section {
      grid-template-columns: 132px minmax(0, 1fr);
      gap: 8px 20px;
      padding-block: 8px;
      break-inside: avoid;
    }

    /* Too long to keep on one page: it breaks between its groups instead. */
    .about-section.long {
      break-inside: auto;
    }

    .about-heading {
      font-size: 15px;
    }

    .about-prose {
      gap: 0.6em;
      font-size: 11.5px;
      line-height: 1.6;
    }

    .projects {
      gap: 6px;
    }

    .project h3 {
      font-size: 12px;
    }

    .project p {
      margin-top: 2px;
      font-size: 11px;
      line-height: 1.5;
    }

    .awards {
      gap: 6px;
    }

    .award-year {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 12px;
    }

    .award-list {
      gap: 1px;
    }

    .award {
      grid-template-columns: 50px minmax(0, 1fr) auto 68px;
      gap: 10px;
      font-size: 11px;
      line-height: 1.3;
    }

    .award-place,
    .award-year-label,
    .award-scope,
    .award-prize {
      font-size: 10px;
    }
  }
</style>
