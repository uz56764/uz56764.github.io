---
import Base from '../layouts/Base.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import InfoPanel, { type InfoRow } from '../components/InfoPanel.astro';
import PostIndex from '../components/PostIndex.astro';
import { getPosts } from '../lib/posts';
import { formatDate, site, url } from '../lib/site';

const posts = await getPosts();
const featured = posts.find(post => post.data.featured) ?? posts[0];

const facts: InfoRow[] = [
  { label: 'Author', value: site.fullName, note: `@${site.author}`, href: url() },
  { label: 'Articles', value: String(posts.length) },
  ...(posts[0] ? [{ label: 'Last post', value: formatDate(posts[0].data.date) }] : []),
  { label: 'Feed', value: 'RSS', href: url('rss.xml') },
];
---

<Base title="Articles" current="articles">
  <section class="shell hero" aria-labelledby="page-title">
    <div>
      <p class="eyebrow">Write-ups &amp; technical reports</p>
      <h1 class="display" id="page-title">Articles</h1>
    </div>
    <InfoPanel class="hero-facts" rows={facts} label="About this blog" />
  </section>

  <div class="divider"></div>

  {featured && <FeaturedPost post={featured} />}
  {posts.length > 0
    ? <PostIndex posts={posts} />
    : <p class="shell empty">No articles yet.</p>}
</Base>

<style>
  /* The facts column starts level with the eyebrow, as on the article page. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: start;
    gap: 36px 64px;
    padding-block: clamp(56px, 8vw, 104px) clamp(40px, 5vw, 64px);
  }

  .hero .display {
    margin-top: 20px;
  }

  .empty {
    padding-top: 64px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero :global(.hero-facts) {
      max-width: 480px;
    }
  }
</style>
