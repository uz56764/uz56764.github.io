---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';

interface Props {
  post: Post;
  sizes: string;
  /** Load eagerly when the cover is likely above the fold. */
  priority?: boolean;
}

const { post, sizes, priority = false } = Astro.props;
const { cover, coverAlt } = post.data;
---

{cover && (
  <div class="post-cover">
    <Image
      src={cover}
      alt={coverAlt ?? ''}
      widths={[480, 720, 960, 1280].filter(width => width < cover.width).concat(cover.width)}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
    />
  </div>
)}

<style>
  .post-cover {
    position: relative;
    overflow: hidden;
    background: #000;
  }

  .post-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 0.5s var(--ease);
  }
</style>
