---
import Icon from './Icon.astro';
import { categories } from '../lib/categories';
import { categorySlug, postUrl, readingMinutes, type Post } from '../lib/posts';
import { displayTitle, formatDate } from '../lib/site';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

// Offer filters only when they can actually narrow the list.
const filters = Object.values(categories)
  .map(({ slug, label }) => ({ slug, label, count: posts.filter(post => categorySlug(post) === slug).length }))
  .filter(filter => filter.count > 0);
const showFilters = filters.length > 1;
---

<section class="shell archive" aria-labelledby="archive-title" data-archive>
  <div class="archive-header">
    <h2 class="archive-title" id="archive-title">
      All articles <span data-archive-count>{posts.length}</span>
    </h2>
    {showFilters && (
      <div class="filters" role="group" aria-label="Filter by category">
        <button class="filter" type="button" aria-pressed="true" data-filter="all">All</button>
        {filters.map(filter => (
          <button class="filter" type="button" aria-pressed="false" data-filter={filter.slug}>
            {filter.label} <span>{filter.count}</span>
          </button>
        ))}
      </div>
    )}
  </div>

  <ol class="post-list" role="list">
    {posts.map(post => (
      <li class="post-row" data-category={categorySlug(post)}>
        <time class="post-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'short')}</time>
        <div class="post-body">
          <h3 class="post-title">
            <a class="stretched-link" href={postUrl(post)}>{displayTitle(post.data.title)}</a>
          </h3>
          <p class="post-excerpt">{post.data.description}</p>
        </div>
        <div class="post-meta">
          <span class="chip">{post.data.category}</span>
          <span class="post-time">{readingMinutes(post)} min read</span>
        </div>
        <Icon class="post-arrow" name="arrow-right" size={18} />
      </li>
    ))}
  </ol>

  <p class="archive-empty" hidden data-archive-empty>No articles in this category yet.</p>
  <p class="sr-only" aria-live="polite" data-archive-status></p>
</section>

<script>
  import '../scripts/archive';
</script>

<style>
  .archive {
    padding-top: clamp(64px, 8vw, 104px);
  }

  .archive-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line-strong);
  }

  .archive-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: clamp(24px, 2.4vw, 30px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .archive-title span {
    font: 400 13px/1 var(--font-mono);
    letter-spacing: 0;
    color: var(--faint);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    font: 400 12px/1 var(--font-mono);
    color: var(--muted);
    transition: color 0.15s, border-color 0.15s;
  }

  .filter span {
    color: var(--faint);
  }

  .filter:hover {
    border-color: var(--muted);
    color: var(--text);
  }

  .filter[aria-pressed='true'] {
    border-color: var(--lime-line);
    color: var(--text);
  }

  .post-row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr) 132px 18px;
    align-items: start;
    gap: 28px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .post-row[hidden] {
    display: none;
  }

  .post-row::before {
    content: '';
    position: absolute;
    inset: 0 -16px;
    z-index: -1;
    background: var(--panel);
    opacity: 0;
    transition: opacity 0.15s;
  }

  .post-row:hover::before {
    opacity: 1;
  }

  .post-row:has(a:focus-visible) {
    outline: 2px solid var(--lime);
    outline-offset: 4px;
  }

  .post-row a:focus-visible {
    outline: none;
  }

  .post-date {
    padding-top: 4px;
    font: 400 13px/1.4 var(--font-mono);
    color: var(--faint);
    white-space: nowrap;
  }

  .post-title {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.02em;
    text-wrap: balance;
    transition: color 0.15s;
  }

  .post-row:hover .post-title {
    color: var(--lime);
  }

  .post-excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    max-width: 70ch;
    margin-top: 8px;
    overflow: hidden;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .post-meta {
    display: grid;
    justify-items: end;
    gap: 10px;
    padding-top: 2px;
  }

  .post-time {
    font: 400 12px/1.4 var(--font-mono);
    color: var(--faint);
  }

  .post-row :global(.post-arrow) {
    margin-top: 4px;
    color: var(--faint);
    transition: color 0.15s, transform 0.2s var(--ease);
  }

  .post-row:hover :global(.post-arrow) {
    color: var(--lime);
    transform: translateX(3px);
  }

  .archive-empty {
    padding: 32px 0;
    color: var(--muted);
  }

  @media (max-width: 800px) {
    .post-row {
      grid-template-columns: minmax(0, 1fr) 18px;
      gap: 10px 16px;
      padding-block: 22px 24px;
    }

    .post-date {
      grid-column: 1;
      padding-top: 0;
      font-size: 12px;
    }

    .post-body {
      grid-column: 1;
    }

    .post-meta {
      grid-column: 1;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 4px;
    }

    .post-row :global(.post-arrow) {
      grid-column: 2;
      grid-row: 2;
      margin-top: 6px;
    }

    .post-title {
      font-size: 19px;
    }

    .post-row::before {
      inset-inline: -12px;
    }
  }
</style>
