---
// The site mark: a 16×16 pixel dinosaur after the profile plush. Drawn at an
// integer scale (2px per cell by default) so every pixel stays crisp.
// `animated` adds a hover chomp: closed → jaw drops → mouth open, eyes squinting.

interface Props {
  size?: number;
  animated?: boolean;
  class?: string;
}

const { size = 32, animated = false, class: className } = Astro.props;

const frames = {
  closed: {
    shade: 'M6 0h2v1h-2zM1 4h1v1h-1zM1 6h1v1h-1zM1 8h1v1h-1zM1 10h1v1h-1zM2 12h1v1h-1zM10 13h1v1h-1z',
    body: 'M5 1h4v1h-4zM3 2h8v1h-8zM2 3h11v1h-11zM2 4h3v1h-3zM7 4h7v1h-7zM2 5h2v1h-2zM7 5h8v1h-8zM2 6h2v1h-2zM7 6h6v1h-6zM14 6h2v1h-2zM2 7h14v1h-14zM2 8h7v1h-7zM10 8h6v1h-6zM2 9h8v1h-8zM15 9h1v1h-1zM3 10h12v1h-12zM4 11h9v1h-9zM3 12h8v1h-8zM3 13h7v1h-7zM4 14h7v1h-7zM4 15h2v1h-2zM8 15h2v1h-2z',
    light: 'M5 4h2v1h-2zM4 5h2v1h-2zM4 6h2v1h-2zM12 9h1v1h-1z',
    dark: 'M6 5h1v1h-1zM6 6h1v1h-1zM13 6h1v1h-1z',
    mouth: 'M9 8h1v1h-1zM10 9h2v1h-2zM13 9h2v1h-2z',
  },
  half: {
    shade: 'M6 0h2v1h-2zM1 4h1v1h-1zM1 6h1v1h-1zM1 8h1v1h-1zM1 10h1v1h-1zM2 12h1v1h-1zM10 13h1v1h-1z',
    body: 'M5 1h4v1h-4zM3 2h8v1h-8zM2 3h11v1h-11zM2 4h3v1h-3zM7 4h7v1h-7zM2 5h2v1h-2zM7 5h8v1h-8zM2 6h2v1h-2zM7 6h6v1h-6zM14 6h2v1h-2zM2 7h14v1h-14zM2 8h14v1h-14zM2 9h7v1h-7zM3 10h6v1h-6zM14 10h2v1h-2zM4 11h11v1h-11zM3 12h8v1h-8zM3 13h7v1h-7zM4 14h7v1h-7zM4 15h2v1h-2zM8 15h2v1h-2z',
    light: 'M5 4h2v1h-2zM4 5h2v1h-2zM4 6h2v1h-2zM12 9h1v1h-1z',
    dark: 'M6 5h1v1h-1zM6 6h1v1h-1zM13 6h1v1h-1z',
    mouth: 'M9 9h3v1h-3zM13 9h2v1h-2zM9 10h5v1h-5z',
  },
  open: {
    shade: 'M6 0h2v1h-2zM1 4h1v1h-1zM1 6h1v1h-1zM1 8h1v1h-1zM1 10h1v1h-1zM2 12h1v1h-1zM10 13h1v1h-1z',
    body: 'M5 1h6v1h-6zM3 2h10v1h-10zM2 3h12v1h-12zM2 4h13v1h-13zM2 5h3v1h-3zM7 5h6v1h-6zM14 5h2v1h-2zM2 6h2v1h-2zM5 6h2v1h-2zM8 6h8v1h-8zM2 7h14v1h-14zM2 8h7v1h-7zM2 9h7v1h-7zM3 10h6v1h-6zM14 10h1v1h-1zM4 11h11v1h-11zM3 12h8v1h-8zM3 13h7v1h-7zM4 14h7v1h-7zM4 15h2v1h-2zM8 15h2v1h-2z',
    light: 'M12 8h1v1h-1z',
    dark: 'M5 5h2v1h-2zM13 5h1v1h-1zM4 6h1v1h-1zM7 6h1v1h-1z',
    mouth: 'M9 8h3v1h-3zM13 8h2v1h-2zM9 9h6v1h-6zM9 10h5v1h-5z',
  },
};

const shown = animated ? (['closed', 'half', 'open'] as const) : (['closed'] as const);
---

<svg
  class:list={['mark', className]}
  data-animated={animated ? '' : undefined}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  shape-rendering="crispEdges"
  aria-hidden="true"
>
  {shown.map(name => (
    <g class={`frame frame-${name}`}>
      {Object.entries(frames[name]).map(([part, d]) => <path class={part} d={d} />)}
    </g>
  ))}
</svg>

<style>
  .body {
    fill: var(--lime);
  }

  .shade {
    fill: #89a800;
  }

  .light {
    fill: #f4f4f4;
  }

  .dark {
    fill: var(--bg);
  }

  .mouth {
    fill: #0d1400;
  }

  /* Frames switch in whole steps so the sprite never blends between poses. */
  .frame-half,
  .frame-open {
    opacity: 0;
  }

  :global(a:hover) > .mark[data-animated] .frame-closed,
  :global(a:focus-visible) > .mark[data-animated] .frame-closed {
    opacity: 0;
  }

  :global(a:hover) > .mark[data-animated] .frame-half,
  :global(a:focus-visible) > .mark[data-animated] .frame-half {
    animation: frame-first 140ms step-end both;
  }

  :global(a:hover) > .mark[data-animated] .frame-open,
  :global(a:focus-visible) > .mark[data-animated] .frame-open {
    animation: frame-second 140ms step-end both;
  }

  @keyframes frame-first {
    0% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @keyframes frame-second {
    0% {
      opacity: 0;
    }
    50%,
    100% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(a:hover) > .mark[data-animated] .frame-half {
      animation: none;
    }

    :global(a:hover) > .mark[data-animated] .frame-open {
      animation: none;
      opacity: 1;
    }
  }
</style>
