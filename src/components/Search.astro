---
import Icon from './Icon.astro';
import { url } from '../lib/site';
---

<dialog class="search" aria-label="Search articles" data-search data-index={url('search-index.json')}>
  <div class="search-field">
    <Icon name="search" size={18} />
    <input
      type="search"
      role="combobox"
      aria-label="Search articles"
      aria-expanded="true"
      aria-controls="search-results"
      aria-autocomplete="list"
      placeholder="Search titles, prose, and code"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
      data-search-input
    />
    <button class="search-close" type="button" aria-label="Close search" data-search-close>
      <kbd>Esc</kbd>
      <Icon name="close" size={18} />
    </button>
  </div>
  <p class="search-status" aria-live="polite" data-search-status></p>
  <ul class="search-results" id="search-results" role="listbox" aria-label="Results" data-search-results></ul>
  <div class="search-footer" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
    <span><kbd>↵</kbd> Open</span>
    <span><kbd>/</kbd> or <kbd>⌘K</kbd> Search anywhere</span>
  </div>
</dialog>

<script>
  import '../scripts/search';
</script>

<style>
  .search {
    width: min(720px, 100% - 32px);
    max-width: none;
    max-height: min(640px, 100dvh - 96px);
    margin: min(14vh, 112px) auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 40px 120px rgb(0 0 0 / 0.8);
    overflow: hidden;
  }

  .search[open] {
    display: flex;
    flex-direction: column;
    animation: search-in 0.16s var(--ease);
  }

  .search::backdrop {
    background: rgb(0 0 0 / 0.78);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  @keyframes search-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    height: 60px;
    padding: 0 12px 0 20px;
    border-bottom: 1px solid var(--line-strong);
  }

  .search-field > :global(svg) {
    color: var(--lime);
  }

  .search-field input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: none;
    font-size: 17px;
    caret-color: var(--lime);
    outline: none;
  }

  .search-field input::placeholder {
    color: var(--faint);
  }

  .search-field input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    color: var(--muted);
  }

  .search-close:hover kbd {
    border-color: var(--text);
    color: var(--text);
  }

  .search-close :global(svg) {
    display: none;
  }

  .search-status {
    flex-shrink: 0;
    padding: 14px 20px 8px;
    font: 400 11px/1.5 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .search-results {
    min-height: 96px;
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .search-results :global(.search-option a) {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 14px 20px 16px;
    border-bottom: 1px solid var(--line);
  }

  .search-results :global(.search-option[aria-selected='true'] a) {
    background: var(--panel-raised);
  }

  .search-results :global(.search-option[aria-selected='true'] a)::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--lime);
  }

  .search-results :global(.search-option-title) {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .search-results :global(.search-option-excerpt) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  .search-results :global(.search-option-excerpt.is-code) {
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  .search-results :global(.search-option-meta) {
    font: 400 11px/1.5 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .search-results :global(mark) {
    background: none;
    color: var(--lime);
  }

  .search-footer {
    display: flex;
    flex-shrink: 0;
    gap: 20px;
    padding: 10px 20px;
    border-top: 1px solid var(--line-strong);
    font-size: 12px;
    color: var(--faint);
  }

  .search-footer span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .search-footer span:last-child {
    margin-left: auto;
  }

  .search-footer kbd {
    height: 18px;
    min-width: 18px;
    font-size: 10px;
  }

  @media (max-width: 640px) {
    .search {
      width: calc(100% - 16px);
      max-height: calc(100dvh - 16px);
      margin-top: 8px;
    }

    .search-field {
      padding-left: 16px;
    }

    .search-close kbd,
    .search-footer {
      display: none;
    }

    .search-close :global(svg) {
      display: block;
    }
  }
</style>
