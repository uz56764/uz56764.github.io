---
const icons = {
  'arrow-right': ['M4 12h16', 'm14 6 6 6-6 6'],
  'arrow-left': ['M20 12H4', 'm10 6-6 6 6 6'],
  'arrow-up': ['M12 20V4', 'm6 10 6-6 6 6'],
  'arrow-up-right': ['M7 17 17 7', 'M8 7h9v9'],
  search: ['m20 20-4.6-4.6', 'M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13Z'],
  download: ['M12 4v11', 'm7 10 5 5 5-5', 'M5 20h14'],
  copy: ['M9 9h11v11H9z', 'M15 9V4H4v11h5'],
  check: ['m5 12.5 4.5 4.5L19 7'],
  close: ['m6 6 12 12', 'M18 6 6 18'],
  'chevron-down': ['m6 9 6 6 6-6'],
  rss: ['M5 11a8 8 0 0 1 8 8', 'M5 5a14 14 0 0 1 14 14', 'M5 19h.01'],
  mail: ['M3 5h18v14H3z', 'm3 6 9 7 9-7'],
  link: ['M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1', 'M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1'],
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="square"
  aria-hidden="true"
>
  {icons[name].map(d => <path d={d} />)}
</svg>
