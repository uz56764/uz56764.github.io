---
import '../styles/global.css';
import geistRegular from '../assets/fonts/Geist-Regular.woff2?url';
import geistPixel from '../assets/fonts/GeistPixel-Square.woff2?url';
import Header, { type Section } from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import { absoluteUrl, site, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  current?: Section;
  /** Absolute or base-relative URL of the social preview image. */
  image?: string;
  article?: { published: Date; modified?: Date; tags: string[] };
  /** Show the reading-progress line in the header. */
  progress?: boolean;
  /** JSON-LD object for this page. */
  schema?: Record<string, unknown>;
}

const { title, description = site.description, current, image, article, progress, schema } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.description}`;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const socialImage = absoluteUrl(image ?? url('og-image.png'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050607" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap.xml')} />
    <link rel="preload" href={geistRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistPixel} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
        {article.tags.map(tag => <meta property="article:tag" content={tag} />)}
      </>
    )}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} progress={progress} />
    <main id="main" class="frame">
      <slot />
    </main>
    <Footer />
    <Search />
    <div class="sr-only" id="announcer" role="status" aria-live="polite"></div>
  </body>
</html>
